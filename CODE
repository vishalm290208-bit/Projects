#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <windows.h> 

#define MAX_SIZE 4
#define EMPTY ' '
#define PLAYER_X 'X'
#define PLAYER_O 'O'

// Renamed struct to avoid naming conflicts
struct GameState {
    char board[MAX_SIZE][MAX_SIZE];
    int size;
    int mode;          // 1 = vs AI, 2 = vs Player
    int difficulty;    // 1 = Easy, 2 = Medium, 3 = Hard, 4 = Advanced
    int moves_count;
};

/* --------- System Utilities --------- */

