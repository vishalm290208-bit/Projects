int getMode() {
    int choice;
    while (1) {
    	printf("\033[0;36m");
        printf("\n+----------------------------------------+\n");
        printf("¦         SELECT GAME MODE               ¦\n");
        printf("+----------------------------------------+\n\033[0m");
        
        printf("\033[0;36m1) Player vs AI\n\033[0m");
        printf("\033[0;36m2) Player vs Player\n\033[0m");
        printf("\033[0;36mEnter choice: \033[0m");

        if (scanf("%d", &choice) == 1) {
            if (choice == 1 || choice == 2) {
                while (getchar() != '\n'); // Clear buffer
                return choice;
            }
