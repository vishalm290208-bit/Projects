/* --------- Board Functions --------- */

void initialize(struct GameState *game) {
    int i, j;
    for (i = 0; i < game->size; i++)
        for (j = 0; j < game->size; j++)
            game->board[i][j] = EMPTY;

    game->moves_count = 0;
}

void display(struct GameState *game) {
    int i, j, loc = 1;
    clearScreen();
    printf("\nTic Tac Toe Board (Enter Location Number):\n\n");

    for (i = 0; i < game->size; i++) {
        for (j = 0; j < game->size; j++) {
            if (game->board[i][j] == EMPTY) {
                printf(" %2d ", loc);
            } else if (game->board[i][j] == PLAYER_X) {
                printf("  %c  ", game->board[i][j]);
            } else {
                printf("  %c  ", game->board[i][j]);
            }
            loc++;
            if (j < game->size - 1) printf("|");
        }
        printf("\n");
        if (i < game->size - 1) {
            for (j = 0; j < game->size; j++) {
                printf("-----");
                if (j < game->size - 1) printf("+");
            }
            printf("\n");
        }
    }
    printf("\n");
}

int checkWin(struct GameState *game, char player) {
    int i, j, count;

    // Check Rows
    for (i = 0; i < game->size; i++) {
        count = 0;
        for (j = 0; j < game->size; j++)
            if (game->board[i][j] == player) count++;
        if (count == game->size) return 1;
    }
    // Check Columns
    for (j = 0; j < game->size; j++) {
        count = 0;
        for (i = 0; i < game->size; i++)
            if (game->board[i][j] == player) count++;
        if (count == game->size) return 1;
    }
    // Check Diagonal 1
    count = 0;
    for (i = 0; i < game->size; i++)
        if (game->board[i][i] == player) count++;
    if (count == game->size) return 1;

    // Check Diagonal 2
    count = 0;
    for (i = 0; i < game->size; i++)
        if (game->board[i][game->size - 1 - i] == player) count++;
    if (count == game->size) return 1;

    return 0;
}

int checkFull(struct GameState *game) {
    return game->moves_count == (game->size * game->size);
}

int isValidMove(struct GameState *game, int row, int col) {
    return (row >= 0 && row < game->size &&
            col >= 0 && col < game->size &&
            game->board[row][col] == EMPTY);
}

void play_move(struct GameState *game, int row, int col, char player) {
    game->board[row][col] = player;
    game->moves_count++;
}

void undoMove(struct GameState *game, int row, int col) {
    game->board[row][col] = EMPTY;
    game->moves_count--;
}

int hasTimeExpired(time_t start_time) {
    double elapsed = difftime(time(NULL), start_time);
    int left = 90 - (int)elapsed;
    if (left < 0) left = 0;
    printf("Time Left: %d seconds\n", left);
    return elapsed >= 90;
}

/* --------- AI Logic --------- */

int evaluateLine(int aiCount, int playerCount) {
    if (aiCount > 0 && playerCount > 0) return 0;
    if (aiCount == 4) return 10000;
    if (aiCount == 3) return 100;
    if (aiCount == 2) return 10;
    if (playerCount == 3) return -100;
    if (playerCount == 4) return -10000;
    return 0;
}

int evaluateBoard(struct GameState *game, char aiPlayer) {
    char userPlayer = (aiPlayer == PLAYER_X) ? PLAYER_O : PLAYER_X;
    int score = 0;
    int i, j, aiCount, userCount;

    // Scan Rows
    for (i = 0; i < game->size; i++) {
        aiCount = 0; userCount = 0;
        for (j = 0; j < game->size; j++) {
            if (game->board[i][j] == aiPlayer) aiCount++;
            else if (game->board[i][j] == userPlayer) userCount++;
        }
        score += evaluateLine(aiCount, userCount);
    }
    // Scan Cols
    for (j = 0; j < game->size; j++) {
        aiCount = 0; userCount = 0;
        for (i = 0; i < game->size; i++) {
            if (game->board[i][j] == aiPlayer) aiCount++;
            else if (game->board[i][j] == userPlayer) userCount++;
        }
        score += evaluateLine(aiCount, userCount);
    }
    // Scan Diagonals
    aiCount = 0; userCount = 0;
    for (i = 0; i < game->size; i++) {
        if (game->board[i][i] == aiPlayer) aiCount++;
        else if (game->board[i][i] == userPlayer) userCount++;
    }
    score += evaluateLine(aiCount, userCount);

    aiCount = 0; userCount = 0;
    for (i = 0; i < game->size; i++) {
        if (game->board[i][game->size - 1 - i] == aiPlayer) aiCount++;
        else if (game->board[i][game->size - 1 - i] == userPlayer) userCount++;
    }
    score += evaluateLine(aiCount, userCount);

    return score;
}

int minimax(struct GameState *game, int depth, int isMax, char aiPlayer, char userPlayer) {
    int i, j, best, val;

    if (checkWin(game, aiPlayer)) return 100 - depth;
    if (checkWin(game, userPlayer)) return depth - 100;
    if (checkFull(game)) return 0;

    if (isMax) {
        best = -10000;
        for (i = 0; i < game->size; i++) {
            for (j = 0; j < game->size; j++) {
                if (game->board[i][j] == EMPTY) {
                    play_move(game, i, j, aiPlayer);
                    val = minimax(game, depth + 1, 0, aiPlayer, userPlayer);
                    undoMove(game, i, j);
                    if (val > best) best = val;
                }
            }
        }
        return best;
    } else {
        best = 10000;
        for (i = 0; i < game->size; i++) {
            for (j = 0; j < game->size; j++) {
                if (game->board[i][j] == EMPTY) {
                    play_move(game, i, j, userPlayer);
                    val = minimax(game, depth + 1, 1, aiPlayer, userPlayer);
                    undoMove(game, i, j);
                    if (val < best) best = val;
                }
            }
        }
        return best;
    }
}

void aiMove(struct GameState *game, char aiPlayer) {
    int row = -1, col = -1, i, j, loc;
    int found = 0, makeMistake = 0;
    int bestVal = -10000, bestScore = -100000;
    int moveVal, currentScore;
    char userPlayer;
    
    userPlayer = (aiPlayer == PLAYER_X) ? PLAYER_O : PLAYER_X;

    if (game->difficulty == 4) {
        if ((rand() % 100) < 10) {
            makeMistake = 1;
        }
    }

    if (game->size == 3 && game->difficulty == 4 && !makeMistake) {
        for (i = 0; i < game->size; i++) {
            for (j = 0; j < game->size; j++) {
                if (game->board[i][j] == EMPTY) {
                    play_move(game, i, j, aiPlayer);
                    moveVal = minimax(game, 0, 0, aiPlayer, userPlayer);
                    undoMove(game, i, j);
                    if (moveVal > bestVal) {
                        bestVal = moveVal;
                        row = i; col = j;
                    }
                }
            }
        }
    }
    else if (game->size == 4 && game->difficulty >= 3 && !makeMistake) {
        for (i = 0; i < game->size; i++) {
            for (j = 0; j < game->size; j++) {
                if (game->board[i][j] == EMPTY) {
                    play_move(game, i, j, aiPlayer);
                    
                    if (checkWin(game, aiPlayer)) {
                        undoMove(game, i, j);
                        row = i; col = j;
                        goto finalize_move; 
                    }

                    currentScore = evaluateBoard(game, aiPlayer);
                    currentScore += (rand() % 5); 
                    undoMove(game, i, j);

                    if (currentScore > bestScore) {
                        bestScore = currentScore;
                        row = i; col = j;
                    }
                }
            }
        }
    }
    else {
        if (!makeMistake) {
            for (i = 0; i < game->size && !found; i++) {
                for (j = 0; j < game->size && !found; j++) {
                    if (isValidMove(game, i, j)) {
                        play_move(game, i, j, aiPlayer);
                        if (checkWin(game, aiPlayer)) { row = i; col = j; found = 1; }
                        undoMove(game, i, j);
                    }
                }
            }
        }
        
        if (!found && !makeMistake && game->difficulty > 1) {
             for (i = 0; i < game->size && !found; i++) {
                for (j = 0; j < game->size && !found; j++) {
                    if (isValidMove(game, i, j)) {
                        play_move(game, i, j, userPlayer);
                        if (checkWin(game, userPlayer)) { row = i; col = j; found = 1; }
                        undoMove(game, i, j);
                    }
                }
            }
        }

        if (!found) {
            do {
                row = rand() % game->size;
                col = rand() % game->size;
            } while (!isValidMove(game, row, col));
        }
    }

finalize_move:
    play_move(game, row, col, aiPlayer);
    loc = row * game->size + col + 1;
    printf("Player %c chose location %d\n", aiPlayer, loc);
}

void playerMove(struct GameState *game, char player) {
    int row, col, loc, max;
    max = game->size * game->size;

    while (1) {
        printf("Player %c, enter location (1-%d): ", player, max);
        if (scanf("%d", &loc) == 1) {
            if (loc >= 1 && loc <= max) {
                loc--;
                row = loc / game->size;
                col = loc % game->size;
                if (isValidMove(game, row, col)) {
                    play_move(game, row, col, player);
                    break;
                } else {
                    printf("That spot is already taken.\n");
                }
            } else {
                printf("Location out of range.\n");
            }
        } else {
             printf("Invalid input.\n");
             while (getchar() != '\n');
        }
    }
}

void playGame() {
    struct GameState game;
    char currentPlayer = PLAYER_X;
    int isGameOver = 0;
    time_t start_time;

    displayMenu();
    game.mode = getMode();
    game.size = getGridSize();

    if (game.mode == 1) game.difficulty = getDifficulty();
    else game.difficulty = 0;

    initialize(&game);
    start_time = time(NULL);

    while (!isGameOver) {
        display(&game);

        if (game.difficulty == 4 && game.mode == 1 && currentPlayer == PLAYER_X) {
            if (hasTimeExpired(start_time)) {
                display(&game);
                printf("\nTIME UP! AI Wins!\n");
                return;
            }
        }

        if (game.mode == 1 && currentPlayer == PLAYER_O) {
            printf("AI is thinking...\n");
            waitSeconds(1);
            aiMove(&game, currentPlayer);
        } else {
            playerMove(&game, currentPlayer);
        }

        if (checkWin(&game, currentPlayer)) {
            display(&game);
            displayGameOver(currentPlayer, game.mode, 0);
            isGameOver = 1;
        }
        else if (checkFull(&game)) {
            display(&game);
            displayGameOver(currentPlayer, game.mode, 1);
            isGameOver = 1;
        }

        currentPlayer = (currentPlayer == PLAYER_X) ? PLAYER_O : PLAYER_X;
    }
}

int main() {
    char playAgain;
    srand((unsigned int)time(NULL));

    do {
        playGame();
        printf("Play again? (y/n): ");
        if (scanf(" %c", &playAgain) != 1) playAgain = 'n';
        while (getchar() != '\n');
    } while (playAgain == 'y' || playAgain == 'Y');

    printf("Thanks for playing!\n");
    return 0;
}
